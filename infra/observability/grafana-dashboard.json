{
  "uid": "pitwall-api",
  "title": "Pit Wall On-Call: API",
  "description": "Prepared for the Observability project (M5 spec L5-6). Metric names come from apps/api/src/http/metrics.ts; apps/api/src/observability.test.ts checks them.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["pitwall"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_request_duration_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "all routes"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/api/runs\",method=\"POST\"}[5m])))",
          "legendFormat": "POST /api/runs"
        }
      ]
    },
    {
      "id": 4,
      "title": "Runs submitted by outcome",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(runs_submitted_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Run rejections by reason",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(run_rejections_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "SLO: POST /api/runs good ratio (28d)",
      "description": "Target 99.5%. Good = not a 5xx and answered within 500 ms (the le=0.5 bucket).",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.995 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_bucket{route=\"/api/runs\",method=\"POST\",status!~\"5..\",le=\"0.5\"}[28d])) / sum(rate(http_request_duration_seconds_count{route=\"/api/runs\",method=\"POST\"}[28d]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "SLO: error budget burn rate",
      "description": "1.0 spends the 0.5% error budget exactly over 28 days. Above 14 for 1h is a page; above 1 for 6h is a ticket.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (sum(rate(http_request_duration_seconds_bucket{route=\"/api/runs\",method=\"POST\",status!~\"5..\",le=\"0.5\"}[1h])) / sum(rate(http_request_duration_seconds_count{route=\"/api/runs\",method=\"POST\"}[1h])))) / 0.005",
          "legendFormat": "1h burn"
        },
        {
          "refId": "B",
          "expr": "(1 - (sum(rate(http_request_duration_seconds_bucket{route=\"/api/runs\",method=\"POST\",status!~\"5..\",le=\"0.5\"}[6h])) / sum(rate(http_request_duration_seconds_count{route=\"/api/runs\",method=\"POST\"}[6h])))) / 0.005",
          "legendFormat": "6h burn"
        }
      ]
    }
  ]
}
